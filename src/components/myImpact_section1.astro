---
import Badges from "./badges.astro";
import MyDashboard from "./my_dashboard.astro";
---

<section>
  <MyDashboard />
  <Badges />
  <!--| Midlertidigt segment. Udskiftes med component |-->
  <!-- <div class="badges">
    <p class="p_imgtext">Badges</p>
    <div class="container">
      <div class="badge"><p class="p_imgtext">1</p></div>
      <div class="badge"><p class="p_imgtext">2</p></div>
