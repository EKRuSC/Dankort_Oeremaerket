---
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const supaReq = await fetch("https://aarkaexetshjvrlgtjff.supabase.co/storage/v1/object/public/Medie/Nature/kriemer-denmark-1619101_1920_resultat.webp", {
  headers: { apikey: key },
});
const imgUrl = supaReq.ok ? supaReq.url : null;
---

<section style={imgUrl ? `background-image: url(${imgUrl})` : ""}>
  <h1>Gør dine daglige betalinger til en del af noget større</h1>
</section>

<style>
  section {
    aspect-ratio: 3/1;
    padding: 2rlh;
    border-radius: 2rlh;
    background-size: cover;
    background-position: center;
    /*-----*/
    display: flex;
    justify-content: center;
    align-items: center;

    h1 {
      text-align: center;
    }
  }
</style>
