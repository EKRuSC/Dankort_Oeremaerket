---
import CtaButton from "./cta_button.astro";

// Fetch video URL from Supabase Storage
const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const supaReq = await fetch("https://aarkaexetshjvrlgtjff.supabase.co/storage/v1/object/public/Medie/HeroVids/0_Hiking_Forest_1080.mp4", {
  headers: { apikey: key },
});
const videoUrl = supaReq.ok ? supaReq.url : null;
---

<section class="hero">
  {
    videoUrl && (
      <video class="hero-video" autoplay muted loop playsinline>
        <source src={videoUrl} type="video/mp4" />
      </video>
    )
  }
  <h1 class="h1_hero">Dankort Øremærket</h1>
  <div class="bottom">
    <p class="p_imgtext">Små betalinger kan blive til noget større, når vi handler sammen</p>
    <div class="button_wrapper">
      <CtaButton text="Læs mere om Dankort Øremærket" link="about" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 16rlh);
    max-width: 88vw;
    margin: 0 -6vw;
    padding: 2rlh;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rlh;
    border-radius: 2rlh;
    overflow: hidden;
  }

  .bottom {
    grid-column: 1/3;
    grid-row: 2;
    z-index: 10;
    height: fit-content;
    width: 100%;
    align-self: flex-end;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap-reverse;
    justify-content: space-between;
    gap: 6rlh;
    row-gap: 2rlh;
    /*-----*/
    .p_imgtext {
      flex-grow: 1;
      width: 40%;
      margin-right: -2rlh;
    }
    .button_wrapper {
      flex-grow: 1;
      height: fit-content;
      width: fit-content;
      display: flex;
      justify-content: center;
      .cta_button {
        /*| STYLING |*/
        background-color: var(--øremærke-gul);
      }
    }
  }

  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  h1,
  .p_imgtext,
  * .cta_button {
    position: relative;
    z-index: 1;
  }
  h1 {
    grid-column: 1/3;
    width: 100%;
    text-wrap: wrap;
  }
  .p_imgtext {
    grid-row: 2;
    height: fit-content;
    width: fit-content;
    margin: 0 0 -2rlh -2rlh;
    padding: 2rlh 2rlh 1rlh 1rlh;
    align-self: flex-end;
    text-align: center;
    /*| STYLING |*/
    border-top-right-radius: 2rlh;
    background-color: var(--baggrund);
  }
</style>
