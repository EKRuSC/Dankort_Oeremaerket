---
import CtaButton from "./cta_button.astro";
---

<section>
  <h2>Donationsbeløb 2026</h2>
  <div class="dashboard">
    <p class="p_displayValue">200.000.000 øre</p>
    <div class="button_wrapper">
      <CtaButton text="Følg udviklingen" link="community" />
    </div>
  </div>
</section>

<style>
  section {
    display: flex;
    flex-direction: column;
    gap: 2rlh;

    .dashboard {
      padding: 1rlh;
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1rlh;
      row-gap: 2rlh;
      align-items: center;
      /*| STYLING |*/
      background-color: var(--grey_2);
      border-radius: 2rlh;

      .p_displayValue {
        flex-grow: 100;
        padding: 1rlh;
        text-align: center;
        /*| STYLING |*/
        border-radius: 2rlh;
        background-color: var(--white);
      }
      .button_wrapper {
        flex-grow: 1;
        padding: 0 1rlh;
        display: flex;
        justify-content: center;
        .cta_button {
          /*| STYLING |*/
          background-color: var(--dankort-rød);
          color: var(--white);
        }
      }
    }
  }
</style>
