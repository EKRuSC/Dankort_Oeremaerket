---
import CtaButton from "./cta_button.astro";

const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

const supaReq = await fetch("https://aarkaexetshjvrlgtjff.supabase.co/storage/v1/object/public/Medie/Nature/nicolasjaegergaard-nature-7045133.jpg", {
  headers: { apikey: key },
});
const imgUrl = supaReq.ok ? supaReq.url : null;
---

<section style={imgUrl ? `background-image: url(${imgUrl})` : ""}>
  <h2>Samarbejdet med<br />Den Danske Naturfond</h2>
  <div class="bottom">
    <div class="button_wrapper">
      <CtaButton text="Se hvordan de arbejder" link="https://naturfonden.dk" />
    </div>
    <p class="p_standard">Gennem samarbejdet med Den Danske Naturfond hjælper Dankort med at give den danske natur mere plads til at gro og leve vildt.</p>
  </div>
</section>

<style>
  section {
    min-height: 32rlh;
    display: grid;
    grid-template-rows: repeat(2, 1fr);
    row-gap: 10rlh;
    /*| STYLING |*/
    border-radius: 2rlh;
    background-size: cover;
    background-position: center;

    h2 {
      height: fit-content;
      width: fit-content;
      padding: 1rlh 2rlh 2rlh 0;
      /*| STYLING |*/
      border-bottom-right-radius: 2rlh;
      background-color: var(--baggrund);
    }

    .bottom {
      grid-row: 2;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 4rlh;
      row-gap: 0;
      /*-----*/
      .p_standard {
        flex-shrink: 0;
        flex-grow: 1;
        width: 50%;
        padding: 2rlh 1rlh 1rlh 2rlh;
        align-self: flex-end;
        justify-content: flex-end;
        /*| STYLING |*/
        border-top-left-radius: 2rlh;
        background-color: var(--baggrund);
      }
      .button_wrapper {
        flex-grow: 1;
        height: fit-content;
        min-width: fit-content;
        width: 25%;
        align-self: flex-end;
        display: flex;
        justify-content: center;
        .cta_button {
          margin: 2rlh;
          /*| STYLING |*/
          background-color: var(--øremærke-gul);
        }
      }
    }
  }
</style>
