---
const badges = [
  {
    id: 1,
    icon: "/trophy_badge.svg",
    title: "Naturhelt",
    unlocked: true,
  },

  {
    id: 2,
    icon: "/leaf_badge.svg",
    title: "Grøn støtte",
    unlocked: true,
  },

  {
    id: 3,
    icon: "/heart_badge.svg",
    title: "Miljøven",
    unlocked: false,
  },

  {
    id: 4,
    icon: "/tree_badge.svg",
    title: "Supporter",
    unlocked: false,
  },

  {
    id: 5,
    icon: "/star_badge.svg",
    title: "Donor",
    unlocked: false,
  },

  {
    id: 6,
    icon: "/earth_badge.svg",
    title: "Impact",
    unlocked: false,
  },
];
---

<div class="badges-section">
  <p class="p_imgtext" id="badges_title">Anders Andersen</p>

  <div class="badges-grid">
    {
      badges.map((badge) => (
        <div class={`badge-card ${badge.unlocked ? "unlocked" : "locked"}`}>
          <img src={badge.icon} alt={badge.title} />

          <p>{badge.title}</p>
        </div>
      ))
    }
  </div>
</div>

<style>
  .badges-section {
    padding: 2rlh;
    display: flex;
    flex-direction: column;
    gap: 2rlh;
    align-items: center;
    border-radius: 2rlh;
    background-color: var(--øremærke-gul);
  }

  .badges-grid {
    width: 100%;
    display: grid;
    grid-template-columns: repeat(auto-fit, 5rlh);
    justify-content: center;
    gap: 2rlh;
  }

  .badge-card {
    aspect-ratio: 1/1;
    width: 5rlh;
    padding: 1rlh;
    display: flex;
    justify-content: center;
    align-items: center;
    border-radius: 100%;
    background-color: var(--white);
  }

  .badge-card img {
    width: 100%;
    height: auto;
  }

  .badge-card p {
    font-size: 0.8rem;
    font-weight: 600;
    text-align: center;
  }

  /* UNLOCKED */

  .unlocked {
    opacity: 1;
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.5);
    transform: scale(1);
  }

  .unlocked:hover {
    transform: scale(1.05);
  }

  /* LOCKED */

  .locked {
    opacity: 0.4;
    filter: grayscale(1);
  }

  @media (max-width: 768px) {
    .badges-section {
      width: 100%;
      padding: 1.5rem;
    }

    .badges-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .badge-card {
      width: 100px;
    }

    .badges-title {
      font-size: 1.2rem;
      margin-bottom: 1.5rem;
    }

    .badge-card p {
      font-size: 0.7rem;
    }
  }
</style>
